DATABASE_URL=
AUTH_SECRET=
PRIVATE_LANE_URL=
PRIVATE_LANE_TOKEN=
BRAND_NAME=
BRAND_TAGLINE=

# Which origins the browser may call this API from. Comma separated, exact origin,
# NO trailing slash. Blank means http://localhost:3000, which is what local dev wants.
CORS_ORIGINS=

# Local dev: leave these blank. DEPLOYED, where the front end and the API sit on
# different domains, set COOKIE_SECURE=true and COOKIE_SAMESITE=none, or the session
# cookie is silently dropped and login appears to do nothing.
COOKIE_SECURE=
COOKIE_SAMESITE=
